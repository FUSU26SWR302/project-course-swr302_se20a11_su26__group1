# ===== Database =====
POSTGRES_DB=nonstopcoding
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Backend connect DB
DB_URL=jdbc:postgresql://localhost:5432/nonstopcoding
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Security
JWT_SIGNER_KEY=your_jwt_signer_key_here

# JWT / Cookie Time (Tính bằng giây)
# 3600s = 1 giờ | 604800s = 7 ngày
JWT_VALID_DURATION=3600
JWT_REFRESHABLE_DURATION=604800
ACCESS_TOKEN_MAX_AGE=3600
REFRESH_TOKEN_MAX_AGE=604800

#Judge0
JUDGE0_URL=https://localhost:2358

# App & Webhook 
WEBHOOK_BASE_URL=https://your_webhook_base_url/nonstopcoding

# PayOS
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:5173/dashboard
PAYOS_CANCEL_URL=http://localhost:5173/dashboard


#Google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

#Gemini
GEMINI_API_KEY=your_gemini_api_key

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
